{
  "name": "dream-team",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "sync:legacy": "node scripts/sync-ryby2026.mjs",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply dream-team-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply dream-team-db --remote",
    "deploy:production": "wrangler d1 migrations apply dream-team-db --remote && wrangler deploy"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
