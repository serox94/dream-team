{
  "name": "dream-team",
  "version": "1.2.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "npm run deploy:production",
    "db:migrate:local": "wrangler d1 migrations apply dream-team-db --local",
    "db:migrate:remote": "node scripts/release-operator.mjs migrate",
    "deploy:production": "node scripts/release-operator.mjs deploy",
    "test": "node --test --test-concurrency=2 tests/*.test.mjs",
    "build": "node scripts/build.mjs && wrangler deploy --dry-run",
    "dev:qa": "node scripts/qa-server.mjs",
    "pretest": "node scripts/build.mjs"
  },
  "devDependencies": {
    "chart.js": "4.5.1",
    "jsdom": "30.1.1",
    "wrangler": "4.150.0"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  }
}
