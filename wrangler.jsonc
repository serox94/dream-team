{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dream-team",
  "main": "src/worker.js",
  "secrets": { "required": ["TAVILY_API_KEY"] },
  "compatibility_date": "2026-09-03",
  "triggers": { "crons": ["0 6 * * *"] },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dream-team-db",
      "database_id": "b64c7a2c-8694-41c6-b54a-857b88bf2c96"
    }
  ],
  "ai": { "binding": "AI" },
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "dream-team-media" },
    { "binding": "BACKUP_STATUS", "bucket_name": "dream-team-d1-backups" }
  ]
}
